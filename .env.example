# Copy to .env and change the secrets: cp .env.example .env
POSTGRES_DB=splitsecond
POSTGRES_USER=splitsecond
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me

# Local S3 stand-in (SeaweedFS) for WAL archives and backups
S3_ACCESS_KEY=splitsecond
S3_SECRET_KEY=change-me-too

# Host ports (5433 avoids clashing with a locally installed PostgreSQL)
POSTGRES_PORT=5433
HTTP_PORT=8080
S3_PORT=9100
